{
  "name": "marionette",
  "displayName": "Marionette",
  "version": "0.0.1",
  "description": "Marionette removes digital barriers by letting you navigate and control any website using natural language, entirely offline and private.",
  "author": "Younes Laaroussi ceo@vidova.ai",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@picovoice/porcupine-web": "^3.0.3",
    "@picovoice/web-voice-processor": "^4.0.9",
    "@plasmohq/messaging": "^0.7.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "@types/animejs": "^3.1.13",
    "@types/howler": "^2.2.12",
    "@types/turndown": "^5.0.5",
    "animejs": "^4.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.544.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^15.7.3",
    "react-icons": "^5.5.0",
    "react-markdown": "8.0.7",
    "remark-gfm": "3.0.1",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.1.1",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "<all_urls>"
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "permissions": [
      "tabs",
      "activeTab",
      "tabCapture",
      "scripting",
      "storage",
      "unlimitedStorage",
      "alarms",
      "audioCapture",
      "sidePanel"
    ],
    "externally_connectable": {},
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "assets/dom-to-semantic-markdown.js",
          "assets/Hey-Marionette_en_wasm_v3_0_0.ppn",
          "assets/porcupine_params.pv"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  },
  "packageManager": "pnpm@10.17.0"
}
